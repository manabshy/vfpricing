{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "allowJs": true,
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@vfpricing/assets": ["libs/assets/src/index.ts"],
      "@vfpricing/common": ["libs/common/src/index.ts"],
      "@vfpricing/defination": ["libs/defination/src/index.ts"],
      "@vfpricing/material": ["libs/material/src/index.ts"],
      "@vfpricing/shared": ["libs/shared/src/index.ts"],
      "@vfpricing/vf-config-db": ["libs/vf-config-db/src/index.ts"],
      "@vfpricing/vf-enums": ["libs/vf-enums/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
